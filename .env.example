# ==============================================================================
# SecOps AutoML & Deep Neural Network Platform Configuration
# ==============================================================================

# Google Antigravity Agent / Gemini API Key (Optional)
# If provided, enables LLM-driven MITRE ATT&CK contextual mapping.
# If omitted, system defaults to the built-in deterministic heuristic cyber engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier
GEMINI_MODEL=gemini-2.5-flash

# Security Boundaries
MAX_FILE_SIZE_MB=50
ENABLE_ZERO_TRUST_MASKING=True

# Default Random Seed for Reproducibility
RANDOM_STATE=42

# Optional: keys for the threat-intelligence rule generator (set one, or import a .env in the sidebar)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
PERPLEXITY_API_KEY=
